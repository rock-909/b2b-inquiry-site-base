{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b2b-inquiry-site-base",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Wrangler-level minification via esbuild. OpenNext split-function minify
  // remains disabled in open-next.config.ts until it has fresh preview proof.
  // Bundle size follows the Cloudflare Workers Free baseline; paid plans are optional.
  "minify": true,
  // Drop __name() annotations from minified output for additional gzip savings.
  "keep_names": false,
  // Keep cold starts close to the visitor when Cloudflare can infer placement.
  "placement": { "mode": "smart" },
  // Workers Logs 基线（免费层 20 万条/天、保留 3 天）：事故取证依赖它。
  // 低频 B2B 站首版全量采样；上线后核对日请求量未接近额度再维持 100%。
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
  // Static assets (OpenNext output)
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  // No cron triggers in current phase.

  "env": {
    "preview": {
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "b2b-inquiry-site-base-next-cache-preview",
        },
      ],
      "vars": {
        "APP_ENV": "preview",
        "DEPLOYMENT_PLATFORM": "cloudflare",
        "NEXT_PUBLIC_BASE_URL": "https://example.invalid",
        "NEXT_PUBLIC_SITE_URL": "https://example.invalid",
        "NEXT_PUBLIC_DEPLOYMENT_PLATFORM": "cloudflare",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADvC8KDbJ54402pb",
        "TURNSTILE_ALLOWED_HOSTS": "localhost,127.0.0.1,example.invalid",
      },
    },
    "production": {
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "b2b-inquiry-site-base-next-cache-production",
        },
      ],
      "vars": {
        "APP_ENV": "production",
        "DEPLOYMENT_PLATFORM": "cloudflare",
        // Placeholder until the production domain is explicitly signed off.
        "NEXT_PUBLIC_BASE_URL": "https://example.invalid",
        "NEXT_PUBLIC_SITE_URL": "https://example.invalid",
        "NEXT_PUBLIC_DEPLOYMENT_PLATFORM": "cloudflare",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADvC8KDbJ54402pb",
        "NEXT_PUBLIC_TEST_MODE": "false",
        "SECURITY_HEADERS_ENABLED": "true",
        "NEXT_PUBLIC_SECURITY_MODE": "strict",
        "TURNSTILE_ALLOWED_HOSTS": "example.invalid",
      },
    },
  },
}
