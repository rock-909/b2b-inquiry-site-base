{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [".open-next/**", ".next/**", ".next-lighthouse/**"],
    "overrides": [
      {
        "files": ["src/lib/content/legal-page.ts"],
        "rules": ["react-doctor/js-combine-iterations"]
      },
      {
        "files": [
          "src/app/[locale]/static-content-page.tsx",
          "src/components/content/legal-page-shell.tsx"
        ],
        "rules": ["react-doctor/only-export-components"]
      }
    ]
  }
}
