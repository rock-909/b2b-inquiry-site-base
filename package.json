{
  "name": "tucsenberg-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": ">=11.18.0 <12"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "vitest run",
    "type-check": "next typegen && tsc --noEmit",
    "type-check:tests": "tsc --project tsconfig.tests.json",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx --config eslint.config.mjs --cache --cache-location .eslintcache --max-warnings 0",
    "knip:check": "knip",
    "react:doctor": "npx --loglevel=error -y react-doctor@latest --verbose --scope changed --blocking warning",
    "react:doctor:report": "npx --loglevel=error -y react-doctor@latest --json --no-score --blocking none",
    "release:verify": "node scripts/starter-checks.js release-verify",
    "website:check": "pnpm type-check && pnpm type-check:tests && pnpm lint:check && pnpm test && pnpm build",
    "website:build:cf": "DEPLOYMENT_PLATFORM=cloudflare NEXT_PUBLIC_DEPLOYMENT_PLATFORM=cloudflare pnpm exec opennextjs-cloudflare build",
    "website:build:cf:debug": "DEPLOYMENT_PLATFORM=cloudflare NEXT_PUBLIC_DEPLOYMENT_PLATFORM=cloudflare pnpm exec opennextjs-cloudflare build --noMinify",
    "website:lighthouse": "node scripts/lighthouse-preflight.js && NEXT_DIST_DIR=.next-lighthouse APP_ENV=production pnpm build && lhci autorun --config=./lighthouserc.js",
    "content:check": "node scripts/starter-checks.js content-manifest --check && node scripts/starter-checks.js content-slugs --strict-frontmatter && node scripts/starter-checks.js translations && node scripts/starter-checks.js message-key-usage",
    "component:governance:test": "pnpm exec vitest run tests/architecture/component-governance.test.ts tests/unit/scripts/component-governance-check.test.ts tests/unit/scripts/component-governance-check-closure.test.ts",
    "component:governance": "node scripts/starter-checks.js component-governance",
    "component:check": "pnpm component:governance:test && pnpm component:governance && pnpm exec storybook build"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/typography": "^0.5.20",
    "airtable": "0.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-intl": "^4.13.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/parser": "^8.0.4",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "16.3.0",
    "@opennextjs/cloudflare": "https://pkg.pr.new/@opennextjs/cloudflare@69807b1",
    "@playwright/test": "^1.62.0",
    "@storybook/nextjs-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.1",
    "eslint-plugin-security": "4.0.1",
    "fast-check": "^4.9.0",
    "js-yaml": "5.2.2",
    "jsdom": "^30.0.1",
    "knip": "^6.29.0",
    "lefthook": "2.1.10",
    "postcss": "^8.5.25",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "4.115.0"
  }
}
