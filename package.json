{
  "name": "b2b-inquiry-site-base",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "vitest run",
    "type-check": "next typegen && tsc --noEmit",
    "type-check:tests": "tsc --project tsconfig.tests.json",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx --config eslint.config.mjs --cache --cache-location .eslintcache --max-warnings 0",
    "format:check": "prettier --check .",
    "knip:check": "knip",
    "react:doctor": "pnpm exec react-doctor --verbose --scope changed --include-untracked --blocking warning",
    "react:doctor:report": "pnpm exec react-doctor --json --no-score --blocking none",
    "canary:airtable": "node scripts/quality/checks/airtable-canary.js",
    "release:verify": "node scripts/quality/checks/release-verify.js",
    "hooks:install": "node scripts/git/install-hooks.js",
    "website:check": "pnpm type-check && pnpm type-check:tests && pnpm lint:check && pnpm format:check && pnpm test && pnpm build",
    "website:build:cf": "DEPLOYMENT_PLATFORM=cloudflare NEXT_PUBLIC_DEPLOYMENT_PLATFORM=cloudflare pnpm exec opennextjs-cloudflare build",
    "website:build:cf:debug": "DEPLOYMENT_PLATFORM=cloudflare NEXT_PUBLIC_DEPLOYMENT_PLATFORM=cloudflare pnpm exec opennextjs-cloudflare build --noMinify",
    "website:lighthouse": "node scripts/lighthouse-preflight.js && NEXT_DIST_DIR=.next-lighthouse APP_ENV=production pnpm build && lhci autorun --config=./lighthouserc.js",
    "content:check": "node scripts/quality/checks/translations.js"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@marsidev/react-turnstile": "^1.5.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.3",
    "next-intl": "^4.13.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^8.0.4",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "16.3.3",
    "@opennextjs/cloudflare": "1.20.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.2",
    "eslint-plugin-security": "4.0.1",
    "fast-check": "^4.9.0",
    "js-yaml": "5.4.1",
    "jsdom": "^30.0.1",
    "knip": "^6.32.3",
    "lefthook": "2.1.10",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "0.9.12",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "typescript": "6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.127.0"
  }
}
